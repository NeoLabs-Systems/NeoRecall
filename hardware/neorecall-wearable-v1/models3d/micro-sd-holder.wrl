# GCT MEM2085-00-115-00-A, 11.52 x 8.06 x 1.15 mm push-pull socket.
# The dark card body is fully contained within the socket envelope; no card
# protrusion is represented or required in the finished enclosure.
DEF SDMETAL Appearance { material Material { diffuseColor 0.58 0.61 0.64 specularColor 0.86 0.86 0.86 shininess 0.72 } }
DEF SDCARD Appearance { material Material { diffuseColor 0.035 0.038 0.042 specularColor 0.08 0.08 0.08 shininess 0.18 } }
DEF SDGOLD Appearance { material Material { diffuseColor 0.78 0.56 0.15 specularColor 0.90 0.74 0.28 shininess 0.70 } }

# Internal high-endurance microSD card and low-profile stamped shield.
Transform { translation 0 0 0.1378 children [ Shape { appearance USE SDCARD geometry Box { size 4.2913 2.9528 0.2756 } } ] }
Transform { translation 0 0 0.4134 children [ Shape { appearance USE SDMETAL geometry Box { size 4.5354 3.1732 0.0906 } } ] }
