<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	No app-sandbox entitlement. NeoRecall installs and supervises a NeoRecall
	server on this machine: it clones with git, installs npm dependencies,
	links the CLI, and registers a LaunchAgent. A sandbox redirects HOME into
	the app container, turns /usr/bin/git into an xcrun shim that refuses to
	run, and denies every one of those writes. Hardened Runtime still applies,
	which is what notarization requires; the sandbox is only mandatory for Mac
	App Store distribution, and NeoRecall ships as a DMG from GitHub. The
	remaining sandbox-era keys are inert without it and kept so that re-enabling
	the sandbox stays a one-line change.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<!-- The Hardened Runtime spelling of the same permission. Inert today and
	     required the moment this build is hardened for notarization, which is
	     not a discovery to make from a silent recording failure. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
