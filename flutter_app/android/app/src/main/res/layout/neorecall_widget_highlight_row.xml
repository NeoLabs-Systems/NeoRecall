<?xml version="1.0" encoding="utf-8"?>
<!-- One open task or promise. The tick is its own target so a commitment can be
     cleared without leaving the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/row_tick"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/widget_action_ghost"
        android:clickable="true"
        android:contentDescription="@string/widget_row_complete_description"
        android:focusable="true"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_check" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_muted"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/row_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
