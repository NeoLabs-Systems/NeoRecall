<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:clickable="true"
    android:focusable="true"
    android:padding="8dp">

    <!-- The shared state ids stay present so one RemoteViews update path can
         address every layout without branching per view. -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/widget_elapsed"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_meter"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_configure"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_action_ready"
        android:clickable="true"
        android:contentDescription="@string/widget_action_description"
        android:focusable="true"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_mic" />

    <TextView
        android:id="@+id/widget_live_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:text="●"
        android:textColor="@color/widget_danger"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
