<?xml version="1.0" encoding="utf-8"?>
<!-- The button-only recorder fills the whole widget, so its shape is a pill
     rather than an oval: square cells round to a circle, wide ones stretch. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="#FFD8A44A" android:endColor="#FFB07D2B" />
    <corners android:radius="999dp" />
    <stroke android:width="1dp" android:color="#66FFFFFF" />
</shape>
