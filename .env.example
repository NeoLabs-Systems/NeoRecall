# Server
# NEORECALL_HOME=~/.neorecall
# NEORECALL_HOST=127.0.0.1
# NEORECALL_PORT=4500
# NEORECALL_PUBLIC_URL=http://localhost:4500
# NEORECALL_TRUST_PROXY=false
# NEORECALL_LOG_LEVEL=info
# NEORECALL_RELEASE_CHANNEL=beta

# Authentication and administration
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_API_KEY=
# NEORECALL_SESSION_TTL_MS=2592000000
# NEORECALL_REGISTRATION_ENABLED=true

# Audio ingest
# MAX_UPLOAD_BYTES=33554432
# NEORECALL_CHUNK_TARGET_MS=30000
# NEORECALL_CHUNK_MIN_MS=15000
# NEORECALL_CHUNK_MAX_MS=120000
# NEORECALL_CHUNK_OVERLAP_MS=2000
# NEORECALL_IMPORT_PART_BYTES=8388608
# NEORECALL_IMPORT_SESSION_CONTINUITY_MS=600000
# NEORECALL_IMPORT_FAILED_TTL_HOURS=24

# Local transcription
# TRANSCRIPTION_PROVIDER=sherpa
# TRANSCRIPTION_API_BASE_URL=
# TRANSCRIPTION_API_KEY=
# NEORECALL_SHERPA_THREADS=4
# NEORECALL_DIARIZATION_ENABLED=true
# NEORECALL_LANGUAGE_DETECTION_MIN_CHARACTERS=30
# NEORECALL_VOICE_MATCH_THRESHOLD=0.72
# NEORECALL_VOICE_MATCH_MARGIN=0.05
# NEORECALL_SPEAKER_CLUSTER_THRESHOLD=0.65
# NEORECALL_SPEAKER_CLUSTER_MARGIN=0.05
# NEORECALL_SPEAKER_CONTINUITY_GAP_MS=4000
# NEORECALL_SPEAKER_CLUSTER_CONTINUITY_THRESHOLD=0.5
# NEORECALL_SPEAKER_PREVIEW_MIN_MS=5000
# NEORECALL_SPEAKER_PREVIEW_MAX_MS=10000
# NEORECALL_SPEAKER_PREVIEW_MAX_BYTES=1048576
# NEORECALL_DEDUPE_TOKEN_SIMILARITY=0.82
# NEORECALL_DEDUPE_TIME_TOLERANCE_MS=2500
# NEORECALL_VAD_THRESHOLD=0.5
# NEORECALL_VAD_MIN_SPEECH_SECONDS=0.25
# NEORECALL_VAD_MIN_SILENCE_SECONDS=0.5
# NEORECALL_DIARIZATION_MIN_ON_SECONDS=0.3
# NEORECALL_DIARIZATION_MIN_OFF_SECONDS=0.2
# NEORECALL_CONVERSATION_HARD_GAP_MS=180000
# NEORECALL_CONVERSATION_SOFT_GAP_MS=60000
# NEORECALL_CONVERSATION_MINIMUM_MS=30000
# NEORECALL_CONVERSATION_QUIET_CLOSE_MS=300000
# NEORECALL_CONVERSATION_VALLEY_QUANTILE=0.25
# NEORECALL_CONVERSATION_SEMANTIC_SIMILARITY_THRESHOLD=0.58
# NEORECALL_CONVERSATION_SEMANTIC_VALLEY_PROMINENCE=0.1
# NEORECALL_CONVERSATION_SEMANTIC_CONTEXT_SEGMENTS=3
# NEORECALL_CONVERSATION_MAXIMUM_MS=14400000
# NEORECALL_CONVERSATION_MAXIMUM_CHARACTERS=200000
# NEORECALL_CONVERSATION_PREVIEW_MIN_CHARACTERS=300
# NEORECALL_CONVERSATION_PREVIEW_REFRESH_CHARACTERS=600
# NEORECALL_CONVERSATION_PREVIEW_MIN_INTERVAL_MS=60000
# NEORECALL_CONVERSATION_PREVIEW_FULL_CHARACTERS=20000

# Local embeddings and search
# NEORECALL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# NEORECALL_EMBEDDING_DIMENSIONS=384
# NEORECALL_REQUIRE_VECTOR=true
# NEORECALL_RRF_K=60
# NEORECALL_SEARCH_RELEVANCE_WEIGHT=0.50
# NEORECALL_SEARCH_RECENCY_WEIGHT=0.25
# NEORECALL_SEARCH_IMPORTANCE_WEIGHT=0.25
# NEORECALL_SEARCH_HALF_LIFE_DAYS=30

# Local language model
# `llama` runs the model in the NeoRecall process and never sends a request off
# the machine. `neorecall setup` downloads the weights; nothing here needs a key.
# AI_PROVIDER=llama
# LLM_MODEL_FILE=llm/gemma-4-E4B_q4_0-it.gguf
# LLM_MODEL_PATH=
# How much the model holds at once, in tokens. This is what decides its memory
# use; consolidation splits longer transcripts to fit it.
# LLM_CONTEXT_SIZE=16384
# 'auto' offloads what the detected GPU has room for and falls back to the CPU.
# LLM_GPU_LAYERS=auto
# LLM_THREADS=0
# LLM_TEMPERATURE=0.2
# How long the weights stay in memory after the last request.
# LLM_IDLE_UNLOAD_MS=600000

# Sending generation elsewhere instead (another machine on the LAN, Ollama,
# llama-server, or a hosted service). Only read when AI_PROVIDER is set to
# openai_compatible. Whether the endpoint is private is your decision.
# AI_PROVIDER=openai_compatible
# AI_API_BASE_URL=http://gpu-box.lan:11434/v1
# AI_API_MODEL=
# AI_API_KEY=

# AI_REQUEST_TIMEOUT_MS=600000
# AI_MAX_RETRIES=2
# AI_CONSOLIDATION_MAX_OUTPUT_TOKENS=6000
# How much transcript one consolidation request reads. Sized against the answer
# it has to write, not against the context; lower it if you see AI_OUTPUT_TRUNCATED.
# NEORECALL_CONSOLIDATION_WINDOW_CHARACTERS=8000
# AI_PREVIEW_MAX_OUTPUT_TOKENS=1500
# NEORECALL_MIN_CONSOLIDATION_INTERVAL_MS=0
# NEORECALL_MAX_CONSOLIDATION_LATENCY_MS=0
# NEORECALL_CONSOLIDATION_MAX_FAILURES=3
# NEORECALL_MIN_AI_AUDIO_MS=0
# NEORECALL_MIN_NEW_MATERIAL_CHARS=1
# NEORECALL_MAX_CONSOLIDATION_INPUT_CHARS=250000
# NEORECALL_MAX_CONSOLIDATION_CONVERSATIONS=1
# NEORECALL_ASK_MAX_PER_HOUR=240
# NEORECALL_ASK_BURST_PER_MINUTE=20

# Workers
# NEORECALL_SCHEDULER_INTERVAL_MS=60000
# NEORECALL_JOB_LEASE_MS=300000
# NEORECALL_JOB_MAX_ATTEMPTS=5
# NEORECALL_DIAGNOSTIC_RETENTION_DAYS=7
# NEORECALL_DIAGNOSTIC_MAX_EVENTS_PER_USER=500
# NEORECALL_DIAGNOSTIC_EXPORT_MAX_EVENTS=250

# Live meeting bot (joins Meet / Zoom / Teams as a notetaker; per-user setup in the app)
# NEORECALL_MEETING_JOIN_TIMEOUT_MS=300000
# NEORECALL_MEETING_LEAVE_GRACE_MS=30000
# NEORECALL_MEETING_SIGNIN_IDLE_TIMEOUT_MS=600000
