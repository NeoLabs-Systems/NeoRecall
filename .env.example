# Server
# NEORECALL_HOME=~/.neorecall
# NEORECALL_HOST=127.0.0.1
# NEORECALL_PORT=4500
# NEORECALL_PUBLIC_URL=http://localhost:4500
# NEORECALL_TRUST_PROXY=false
# NEORECALL_LOG_LEVEL=info
# NEORECALL_RELEASE_CHANNEL=beta

# Authentication and administration
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_API_KEY=
# NEORECALL_SESSION_TTL_MS=2592000000
# NEORECALL_REGISTRATION_ENABLED=true

# Audio ingest
# MAX_UPLOAD_BYTES=33554432
# NEORECALL_CHUNK_TARGET_MS=30000
# NEORECALL_CHUNK_MIN_MS=15000
# NEORECALL_CHUNK_MAX_MS=120000
# NEORECALL_CHUNK_OVERLAP_MS=2000
# NEORECALL_IMPORT_PART_BYTES=8388608
# NEORECALL_IMPORT_SESSION_CONTINUITY_MS=600000
# NEORECALL_IMPORT_FAILED_TTL_HOURS=24
# Grace period before an unreferenced file in a work directory is swept as leaked.
# NEORECALL_ORPHAN_FILE_GRACE_MS=60000
# Skip transcribing a chunk when this fraction of its timeline already exists
# on another source of the same device (a live take plus a later file import).
# NEORECALL_SAME_DEVICE_COVERAGE_RATIO=0.5

# Recording context (highlights, notes, images, and documents)
# NEORECALL_CONTEXT_MAX_FILE_BYTES=33554432
# NEORECALL_CONTEXT_NOTE_MAX_CHARACTERS=20000
# NEORECALL_CONTEXT_EXTRACTION_MAX_CHARACTERS=500000
# NEORECALL_CONTEXT_MAX_ITEMS=200
# NEORECALL_CONTEXT_IMAGE_ANALYSIS_MAX_BYTES=5242880

# External transcription. Supported values: openai, groq, deepgram,
# assemblyai, and openai-compatible. The custom provider accepts either a base
# URL ending in /v1 or the full /audio/transcriptions endpoint.
# TRANSCRIPTION_PROVIDER=openai-compatible
# TRANSCRIPTION_API_BASE_URL=
# TRANSCRIPTION_API_MODEL=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_API_LANGUAGE=
# TRANSCRIPTION_API_RESPONSE_FORMAT=verbose_json
# TRANSCRIPTION_REQUEST_TIMEOUT_MS=1800000
# TRANSCRIPTION_POLL_INTERVAL_MS=1000
# Per-user custom vocabulary and automatically included speaker names share these limits.
# NEORECALL_CUSTOM_VOCABULARY_MAX_TERMS=100
# NEORECALL_CUSTOM_VOCABULARY_MAX_TERM_LENGTH=120
# Conservative transcript correction for providers without native vocabulary support.
# NEORECALL_VOCABULARY_CORRECTION_MIN_LENGTH=8
# NEORECALL_VOCABULARY_CORRECTION_MAX_DISTANCE=2
# NEORECALL_VOCABULARY_CORRECTION_SIMILARITY=0.84
# NEORECALL_VOCABULARY_CORRECTION_AMBIGUITY_MARGIN=0.08

# Encrypted database backups. The destination layer accepts remote targets;
# "local" writes to ~/.neorecall/backups. Artifacts are always encrypted.
# NEORECALL_BACKUP_ENABLED=true
# NEORECALL_BACKUP_DESTINATION=local
# NEORECALL_BACKUP_INTERVAL_HOURS=24
# NEORECALL_BACKUP_RETAIN=3

# Per-user Nextcloud backup (write-only copies of one account's audio and data).
# NEORECALL_CLOUD_USER_BACKUP_INTERVAL_HOURS=24
# NEORECALL_CLOUD_PENDING_MAX_AGE_MS=604800000
# NEORECALL_CLOUD_LOGIN_TIMEOUT_MS=1200000
# NEORECALL_CLOUD_HTTP_TIMEOUT_MS=120000
# NEORECALL_CLOUD_PUT_MAX_ATTEMPTS=8
# NEORECALL_CLOUD_CONCAT_TIMEOUT_MS=600000

# Audio conditioning before transcription. A short ffmpeg filter chain that
# levels and cleans a recording so the transcription service hears it under
# better conditions. Pure signal processing, so it helps every language equally.
# See docs/docs/configuration.md before changing any of it.
# NEORECALL_AUDIO_PREPROCESS_ENABLED=true
# Which passes read the conditioned audio. The default gives it only to the
# transcription service; stt+analysis also feeds speech detection and speaker
# identity, which measurably separates voices worse. See the docs first.
# NEORECALL_AUDIO_PREPROCESS_TARGET=stt
# Removes rumble, handling noise and any DC offset. 0 disables the stage.
# NEORECALL_AUDIO_PREPROCESS_HIGHPASS_HZ=70
# Gentle by default: aggressive denoising erodes consonants and costs accuracy.
# NEORECALL_AUDIO_PREPROCESS_DENOISE_ENABLED=true
# NEORECALL_AUDIO_PREPROCESS_DENOISE_DB=6
# NEORECALL_AUDIO_PREPROCESS_DENOISE_FLOOR_DB=-40
# dynaudnorm, loudnorm, speechnorm or off. loudnorm is the most correct and by
# far the most expensive.
# NEORECALL_AUDIO_PREPROCESS_NORMALIZER=dynaudnorm
# Ceiling on how far a quiet passage may be lifted.
# NEORECALL_AUDIO_PREPROCESS_MAX_GAIN=8
# Only read when the normalizer is loudnorm.
# NEORECALL_AUDIO_PREPROCESS_TARGET_LUFS=-18
# NEORECALL_AUDIO_PREPROCESS_TRUE_PEAK_DB=-2
# NEORECALL_AUDIO_PREPROCESS_LIMITER_ENABLED=true
# NEORECALL_AUDIO_PREPROCESS_LIMITER_PEAK=0.95
# NEORECALL_AUDIO_PREPROCESS_SAMPLE_RATE=16000
# wav, or flac for roughly half the upload on a metered connection.
# NEORECALL_AUDIO_PREPROCESS_FORMAT=wav
# NEORECALL_AUDIO_PREPROCESS_TIMEOUT_MS=120000
# Recordings longer than this are transcribed without conditioning. 0 lifts it.
# NEORECALL_AUDIO_PREPROCESS_MAX_DURATION_MS=1800000

# Speech detection and speaker identity run locally; see docs/docs/configuration.md.
# NEORECALL_DIARIZATION_ENABLED=true
# NEORECALL_SHERPA_THREADS=2
# NEORECALL_VAD_THRESHOLD=0.5
# NEORECALL_VAD_MIN_SPEECH_SECONDS=0.25
# NEORECALL_VAD_MIN_SILENCE_SECONDS=0.5
# NEORECALL_DIARIZATION_MIN_ON_SECONDS=0.3
# NEORECALL_DIARIZATION_MIN_OFF_SECONDS=0.2
# Distance for grouping voices inside one chunk; higher value = fewer speakers.
# NEORECALL_DIARIZATION_CLUSTER_DISTANCE=0.65
# Provider-specific keys can be used instead of TRANSCRIPTION_API_KEY:
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# NEORECALL_VOICE_MATCH_THRESHOLD=0.62
# NEORECALL_VOICE_MATCH_MARGIN=0.05
# NEORECALL_SPEAKER_CLUSTER_THRESHOLD=0.52
# NEORECALL_SPEAKER_CLUSTER_MERGE_THRESHOLD=0.55
# Speech shorter than this may join an existing voice but never creates a new one.
# NEORECALL_SPEAKER_MINIMUM_TURN_MS=500
# NEORECALL_SPEAKER_CLUSTER_MARGIN=0.05
# NEORECALL_SPEAKER_CONTINUITY_GAP_MS=4000
# NEORECALL_SPEAKER_CLUSTER_CONTINUITY_THRESHOLD=0.42
# A voice must score below the enrollment floor against every known profile,
# and carry at least this much speech, before it is enrolled as a new person.
# NEORECALL_VOICE_ENROLL_FLOOR=0.45
# NEORECALL_VOICE_ENROLL_MIN_MS=3000
# Score at which two profiles that are each other's best match are repaired
# into one.
# NEORECALL_VOICE_REPAIR_THRESHOLD=0.50
# How long a conversation stays eligible for speaker re-detection.
# NEORECALL_SPEAKER_REDETECT_DAYS=30
# NEORECALL_SPEAKER_PREVIEW_MIN_MS=1000
# NEORECALL_SPEAKER_PREVIEW_MAX_MS=10000
# Only profiles with at least this much clean preview audio appear in Speakers.
# NEORECALL_SPEAKER_DISPLAY_MIN_PREVIEW_MS=10000
# NEORECALL_SPEAKER_PREVIEW_MAX_BYTES=1048576
# NEORECALL_DEDUPE_TOKEN_SIMILARITY=0.82
# NEORECALL_DEDUPE_TIME_TOLERANCE_MS=2500
# Compact structurally repeated ASR output only when it dominates a segment and
# implies an implausible speaking rate. These settings are phrase-independent.
# NEORECALL_TRANSCRIPT_REPETITION_MIN_REPEATS=8
# NEORECALL_TRANSCRIPT_REPETITION_MAX_PATTERN_WORDS=8
# NEORECALL_TRANSCRIPT_REPETITION_MIN_COVERAGE=0.8
# NEORECALL_TRANSCRIPT_MAX_WORDS_PER_SECOND=5
# Where one recording is cut into conversations. Time alone separates two
# sittings and nothing finer: the hard gap. Below it a boundary needs evidence
# that the subject changed, and a missing embedding is not evidence — so the
# same recording is grouped the same way whether or not indexing has caught up.
# The quiet-close delay may not be shorter than the hard gap, or a conversation
# closes while a pause could still continue it.
# NEORECALL_CONVERSATION_HARD_GAP_MS=600000
# NEORECALL_CONVERSATION_SOFT_GAP_MS=300000
# NEORECALL_CONVERSATION_MINIMUM_MS=300000
# NEORECALL_CONVERSATION_QUIET_CLOSE_MS=600000
# NEORECALL_CONVERSATION_VALLEY_QUANTILE=0.25
# NEORECALL_CONVERSATION_SEMANTIC_SIMILARITY_THRESHOLD=0.58
# NEORECALL_CONVERSATION_SEMANTIC_VALLEY_PROMINENCE=0.1
# NEORECALL_CONVERSATION_SEMANTIC_CONTEXT_SEGMENTS=3
# NEORECALL_CONVERSATION_MAXIMUM_MS=14400000
# NEORECALL_CONVERSATION_MAXIMUM_CHARACTERS=200000
# NEORECALL_CONVERSATION_PREVIEW_MIN_CHARACTERS=300
# NEORECALL_CONVERSATION_PREVIEW_REFRESH_CHARACTERS=600
# NEORECALL_CONVERSATION_PREVIEW_MIN_INTERVAL_MS=60000
# NEORECALL_CONVERSATION_PREVIEW_FULL_CHARACTERS=20000

# Local embeddings and search
# NEORECALL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# NEORECALL_EMBEDDING_DIMENSIONS=384
# Defaults to true only when NODE_ENV=production; elsewhere a missing
# sqlite-vec is a warning rather than a refusal to start.
# NEORECALL_REQUIRE_VECTOR=true
# NEORECALL_RRF_K=60
# NEORECALL_SEARCH_RELEVANCE_WEIGHT=0.50
# NEORECALL_SEARCH_RECENCY_WEIGHT=0.25
# NEORECALL_SEARCH_IMPORTANCE_WEIGHT=0.25
# NEORECALL_SEARCH_HALF_LIFE_DAYS=30
# Cosine similarity a vector neighbour must reach to count as evidence. The
# index returns the k nearest embeddings whatever their distance, so without a
# floor an archive with nothing relevant in it still answers with its least
# irrelevant rows. Lower it if real matches are being missed.
# NEORECALL_SEMANTIC_SIMILARITY_FLOOR=0.62
# Ask reads a question into a retrieval plan first: what to look for, and over
# which stretch of time. These bound that plan.
# NEORECALL_ASK_MAX_SEARCH_QUERIES=3
# NEORECALL_ASK_TIME_WINDOW_LIMIT=40
# Ask reads the written record (memories, their details, daily summaries) first
# and raw transcript segments second, so a day's speech cannot crowd out what
# was written about it. These are the slots each layer gets.
# NEORECALL_ASK_MEMORY_CONTEXT_LIMIT=12
# NEORECALL_ASK_TRANSCRIPT_CONTEXT_LIMIT=4
# NEORECALL_ASK_QUOTA_WINDOW_MS=3600000
# NEORECALL_ASK_CITATION_EXCERPT_CHARS=240
# Headroom kept free in an Ask prompt for the question and the answer format.
# NEORECALL_ASK_PROMPT_RESERVE_CHARACTERS=1000
# NEORECALL_ASK_QUOTA_RETENTION_MS=7200000
# NEORECALL_EVENT_OUTBOX_POLL_LIMIT=100
# NEORECALL_EVENT_OUTBOX_KEEPALIVE_MS=15000
# NEORECALL_OAUTH_BROWSER_GRANT_TTL_MS=900000
# NEORECALL_TWO_FACTOR_LOCK_AFTER_FAILURES=5
# NEORECALL_TWO_FACTOR_LOCK_MS=300000
# How many single-use recovery codes are issued when 2FA is enabled.
# NEORECALL_TWO_FACTOR_RECOVERY_CODE_COUNT=10
# How long a half-finished OAuth sign-in may wait at the 2FA prompt.
# NEORECALL_OAUTH_PENDING_2FA_TTL_MS=300000
# NEORECALL_FTS_MAX_TERMS=30
# NEORECALL_JOB_RETRY_BASE_MS=5000
# NEORECALL_JOB_RETRY_MAX_MS=900000
# NEORECALL_WORKER_HEARTBEAT_MS=5000
# NEORECALL_WORKER_LEASE_RENEW_MS=30000
# How long a worker waits before asking for work again when the queue is empty.
# Lower reacts sooner; higher leaves an idle machine quieter.
# NEORECALL_WORKER_IDLE_POLL_MS=500
# NEORECALL_CONSOLIDATION_INTERRUPT_MS=1800000
# NEORECALL_PROCESSING_STALLED_QUEUE_MS=1800000
# NEORECALL_PROCESSING_WORKER_SILENT_MS=300000
# How long an account owner's standing instructions may be, per area (global,
# memories, summaries, ask). They are sent with every request in their area.
# NEORECALL_CUSTOM_INSTRUCTIONS_MAX_CHARACTERS=2000

# External language model. Supported values: openai, anthropic, google, groq,
# mistral, xai, deepseek, openrouter, together, and openai_compatible.
# AI_PROVIDER=openai_compatible
# AI_API_BASE_URL=
# AI_API_MODEL=
# AI_API_KEY=
# Extra JSON merged into every language-model request body, for provider-specific
# fields no shared contract covers. Qwen-family servers accept:
# AI_API_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Provider-specific keys can be used instead of AI_API_KEY:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=

# How much the external model can hold at once. Consolidation splits longer
# transcripts to fit it.
# LLM_CONTEXT_SIZE=16384
# LLM_TEMPERATURE=0.2

# AI_REQUEST_TIMEOUT_MS=1800000
# AI_MAX_RETRIES=2
# AI_CONSOLIDATION_MAX_OUTPUT_TOKENS=8000
# How much transcript one consolidation request reads. Sized against the answer
# it has to write, not against the context; lower it if you see AI_OUTPUT_TRUNCATED.
# NEORECALL_CONSOLIDATION_WINDOW_CHARACTERS=8000
# AI_PREVIEW_MAX_OUTPUT_TOKENS=4000
# NEORECALL_MIN_CONSOLIDATION_INTERVAL_MS=0
# NEORECALL_MAX_CONSOLIDATION_LATENCY_MS=0
# NEORECALL_CONSOLIDATION_MAX_FAILURES=3
# How long a conversation waits after a failed consolidation, doubling per
# attempt up to the maximum, so a bad input cannot re-enter every run.
# NEORECALL_CONSOLIDATION_FAILURE_BACKOFF_BASE_MS=60000
# NEORECALL_CONSOLIDATION_FAILURE_BACKOFF_MAX_MS=1800000
# NEORECALL_MIN_AI_AUDIO_MS=0
# What a memory card has to be worth writing: speech duration AND transcript
# length. Below either floor the section still gets a title and summary.
# NEORECALL_MIN_MEMORY_EVIDENCE_MS=120000
# NEORECALL_MIN_MEMORY_EVIDENCE_CHARS=400
# What counts as one sitting: the break above which a later conversation
# starts its own occasion, how long an occasion must be quiet before it is
# written up, and the age at which an always-on recording is written up
# anyway. The first two may not be shorter than the conversation hard gap.
# NEORECALL_MEMORY_OCCASION_GAP_MS=900000
# NEORECALL_MEMORY_SETTLE_MS=600000
# NEORECALL_MEMORY_OCCASION_MAX_WAIT_MS=3600000
# NEORECALL_MIN_NEW_MATERIAL_CHARS=1
# NEORECALL_MAX_CONSOLIDATION_INPUT_CHARS=250000
# A ceiling on one chain of related conversations, not a batch of unrelated
# ones. See docs/docs/configuration.md.
# NEORECALL_MAX_CONSOLIDATION_CONVERSATIONS=12
# NEORECALL_MAX_MEMORY_CONTINUATION_CANDIDATES=8
# How far across separate recording sessions an existing memory remains
# available to the model as a possible continuation of the same occasion.
# NEORECALL_MEMORY_CONTINUATION_LOOKBACK_MS=7200000
# NEORECALL_MEMORY_MERGE_MAX_ITEMS=100
# The sweep that merges cards describing one occasion that were written
# separately. Nothing outside the window is ever considered; the similarity
# threshold only decides which pairs are worth asking the model about, and
# nothing is merged on that number alone. Calibrate it against your own
# recordings with `node scripts/memory_dedupe_report.js`.
# NEORECALL_MEMORY_DEDUPE_ENABLED=true
# NEORECALL_MEMORY_DEDUPE_WINDOW_MS=21600000
# NEORECALL_MEMORY_DEDUPE_SIMILARITY_THRESHOLD=0.88
# NEORECALL_MEMORY_DEDUPE_MAX_PAIRS_PER_RUN=20
# NEORECALL_MEMORY_DEDUPE_NEIGHBOURS=5
# NEORECALL_ASK_MAX_PER_HOUR=240
# NEORECALL_ASK_BURST_PER_MINUTE=20
# Rolling per-user provider budgets. 0 = unlimited (the self-hosted default).
# NEORECALL_AI_TOKENS_4H=0
# NEORECALL_AI_TOKENS_WEEKLY=0
# NEORECALL_TRANSCRIPTION_SECONDS_4H=0
# NEORECALL_TRANSCRIPTION_SECONDS_WEEKLY=0
# A request reserves budget before it is sent and settles on the real usage.
# The TTL releases a reservation whose request died without reporting back.
# NEORECALL_USAGE_RESERVATION_TTL_MS=900000
# NEORECALL_USAGE_MAX_RESERVATION_TOKENS=100000

# Plaud Note Pro / NotePin S over BLE (Embedded SDK). Partner app credentials
# from https://portal.plaud.ai — used only to mint per-user bind tokens.
# Recordings stay on the device and in NeoRecall; Plaud transcription is unused.
# NEORECALL_PLAUD_CLIENT_ID=
# NEORECALL_PLAUD_CLIENT_SECRET=
# NEORECALL_PLAUD_API_HOST=platform-us.plaud.ai

# Workers
# NEORECALL_SCHEDULER_INTERVAL_MS=60000
# NEORECALL_JOB_LEASE_MS=1800000
# NEORECALL_JOB_MAX_ATTEMPTS=5
# NEORECALL_DIAGNOSTIC_RETENTION_DAYS=7
# NEORECALL_DIAGNOSTIC_MAX_EVENTS_PER_USER=500
# NEORECALL_DIAGNOSTIC_EXPORT_MAX_EVENTS=250
