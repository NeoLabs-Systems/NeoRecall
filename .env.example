# Server
# NEORECALL_HOME=~/.neorecall
# NEORECALL_HOST=127.0.0.1
# NEORECALL_PORT=4500
# NEORECALL_PUBLIC_URL=http://localhost:4500
# NEORECALL_TRUST_PROXY=false
# NEORECALL_LOG_LEVEL=info
# NEORECALL_RELEASE_CHANNEL=beta

# Authentication and administration
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_API_KEY=
# NEORECALL_SESSION_TTL_MS=2592000000
# NEORECALL_REGISTRATION_ENABLED=true

# Audio ingest
# MAX_UPLOAD_BYTES=33554432
# NEORECALL_CHUNK_TARGET_MS=30000
# NEORECALL_CHUNK_MIN_MS=15000
# NEORECALL_CHUNK_MAX_MS=120000
# NEORECALL_CHUNK_OVERLAP_MS=2000
# NEORECALL_IMPORT_PART_BYTES=8388608
# NEORECALL_IMPORT_FAILED_TTL_HOURS=24

# Local transcription
# TRANSCRIPTION_PROVIDER=sherpa
# TRANSCRIPTION_API_BASE_URL=
# TRANSCRIPTION_API_KEY=
# NEORECALL_SHERPA_THREADS=4
# NEORECALL_DIARIZATION_ENABLED=true
# NEORECALL_VOICE_MATCH_THRESHOLD=0.72
# NEORECALL_VOICE_MATCH_MARGIN=0.05
# NEORECALL_SPEAKER_CLUSTER_THRESHOLD=0.65
# NEORECALL_DEDUPE_TOKEN_SIMILARITY=0.82
# NEORECALL_DEDUPE_TIME_TOLERANCE_MS=2500
# NEORECALL_VAD_THRESHOLD=0.5
# NEORECALL_VAD_MIN_SPEECH_SECONDS=0.25
# NEORECALL_VAD_MIN_SILENCE_SECONDS=0.5
# NEORECALL_DIARIZATION_MIN_ON_SECONDS=0.3
# NEORECALL_DIARIZATION_MIN_OFF_SECONDS=0.2
# NEORECALL_CONVERSATION_HARD_GAP_MS=180000
# NEORECALL_CONVERSATION_MINIMUM_MS=30000
# NEORECALL_CONVERSATION_QUIET_CLOSE_MS=300000
# NEORECALL_CONVERSATION_VALLEY_QUANTILE=0.25

# Local embeddings and search
# NEORECALL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# NEORECALL_EMBEDDING_DIMENSIONS=384
# NEORECALL_REQUIRE_VECTOR=true
# NEORECALL_RRF_K=60
# NEORECALL_SEARCH_RELEVANCE_WEIGHT=0.50
# NEORECALL_SEARCH_RECENCY_WEIGHT=0.25
# NEORECALL_SEARCH_IMPORTANCE_WEIGHT=0.25
# NEORECALL_SEARCH_HALF_LIFE_DAYS=30

# OpenRouter (the only supported LLM provider in v1)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_DEFAULT_MODEL=
# AI_REQUEST_TIMEOUT_MS=120000
# AI_MAX_RETRIES=2
# NEORECALL_MIN_CONSOLIDATION_INTERVAL_MS=3600000
# NEORECALL_MIN_NEW_MATERIAL_CHARS=1500
# NEORECALL_MAX_CONSOLIDATION_INPUT_CHARS=50000
# NEORECALL_ASK_MAX_PER_HOUR=20
# NEORECALL_ASK_BURST_PER_MINUTE=5

# Workers
# NEORECALL_JOB_LEASE_MS=300000
# NEORECALL_JOB_MAX_ATTEMPTS=5
