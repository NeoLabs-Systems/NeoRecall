{
  "name": "neorecall",
  "version": "0.1.0-beta.23",
  "description": "Private, self-hosted audio memory for the NeoLabs Ecosystem",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "main": "server/index.js",
  "bin": {
    "neorecall": "bin/neorecall.js"
  },
  "files": [
    "bin",
    "lib",
    "runtime",
    "models",
    "server",
    "flutter_app/build/web",
    "landing",
    "scripts",
    "test/fixtures",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GUIDELINES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start:http": "NEORECALL_ROLE=http node server/index.js",
    "start:worker": "NEORECALL_ROLE=worker node server/workers/index.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "migrate": "node lib/schema_migrations.js",
    "setup": "node bin/neorecall.js setup",
    "test": "npm run test:backend",
    "test:backend": "node scripts/run_tests.js",
    "test:unit": "NODE_ENV=test node --test test/unit/*.test.js",
    "test:api": "NODE_ENV=test node --test test/api/*.test.js",
    "test:e2e": "node scripts/e2e_smoke.js",
    "load:backlog": "node scripts/load_backlog.js",
    "verify:models": "node scripts/verify_models.js",
    "verify:no-audio": "node scripts/verify_no_audio_retained.js",
    "flutter:test": "cd flutter_app && flutter test",
    "flutter:analyze": "cd flutter_app && flutter analyze",
    "build:web": "cd flutter_app && flutter build web --release --base-href /app/",
    "prepublishOnly": "npm run build:web",
    "docs:dev": "cd docs && npm run start",
    "docs:build": "cd docs && npm run build",
    "manage": "node bin/neorecall.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@huggingface/hub": "2.13.3",
    "@huggingface/transformers": "4.2.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.11.1",
    "chalk": "4.1.2",
    "compression": "^1.8.1",
    "discord.js": "^14.27.0",
    "dotenv": "16.6.1",
    "express": "^4.22.2",
    "ffmpeg-static": "5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "multer": "^2.0.2",
    "opusscript": "^0.0.8",
    "otplib": "12.0.1",
    "playwright": "^1.62.0",
    "playwright-extra": "^4.3.6",
    "prism-media": "^1.3.5",
    "prompts": "2.4.2",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "sqlite-vec": "0.1.9",
    "tinyld": "1.3.4",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.4"
  },
  "devDependencies": {
    "supertest": "7.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoLabs-Systems/NeoRecall.git"
  },
  "homepage": "https://github.com/NeoLabs-Systems/NeoRecall",
  "bugs": {
    "url": "https://github.com/NeoLabs-Systems/NeoRecall/issues"
  }
}
